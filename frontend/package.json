{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "run-s lint:*",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint",
    "lint:prettier": "prettier --check . --ignore-path ../.prettierignore",
    "lint:typescript": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "build": "vite build",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@janejeon/calendars-shared": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "wrangler": "^4.131.0"
  }
}
