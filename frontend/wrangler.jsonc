{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "calendars-frontend",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "routes": [{ "pattern": "cal.janejeon.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
